# Digital Signature Factory - Environment Configuration
# Copy this file to .env and update with your values

# Application Settings
APP_NAME="Digital Signature Factory"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Cairo

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=digital_signature_factory
DB_USERNAME=dsf_user
DB_PASSWORD=ChangeMe123!SecurePassword

# Redis Configuration (Optional for caching/queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# JWT Authentication
JWT_SECRET=YourSuperSecretJWTKey2026ChangeThisInProduction!
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Encryption Key (32 characters)
APP_KEY=Base64Encoded32CharacterEncryptionKey!

# File Upload Settings
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pfx,p12,pem,cer,crt,xml,json,pdf

# Token/PKCS11 Settings
PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
DEFAULT_TOKEN_PIN=12345678

# Email Configuration (for notifications)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Audit Log Settings
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ZATCA Settings (Saudi Arabia)
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa/e-invoice/developer-portal
ZATCA_CLIENT_ID=
ZATCA_CLIENT_SECRET=

# ETRANZACT Settings (Egypt)
ETRANZACT_API_URL=https://etransact.gov.eg/api/v1
ETRANZACT_API_KEY=

# FTA Settings (UAE)
FTA_API_URL=https://tax.gov.ae/api
FTA_API_KEY=

# Timestamp Authority
TSA_URL=http://timestamp.digicert.com
TSA_USERNAME=
TSA_PASSWORD=

# OCSP Settings
OCSP_ENABLED=true
OCSP_RESPONDER_URL=

# System Settings
SYSTEM_ADMIN_EMAIL=admin@yourdomain.com
SESSION_LIFETIME=120
LOG_CHANNEL=daily
LOG_LEVEL=info
