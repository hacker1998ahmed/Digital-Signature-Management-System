{
    "name": "dsfactory/digital-signature-factory",
    "description": "مصنع التوقيع الرقمي - نظام متكامل لإدارة الشهادات الرقمية والتوقيع الإلكتروني للبوابات الحكومية المصرية والخليجية",
    "type": "project",
    "license": "proprietary",
    "keywords": [
        "digital-signature",
        "egypt",
        "etransact",
        "zatca",
        "pkcs11",
        "openssl",
        "certificate",
        "egytrust",
        "mcb"
    ],
    "authors": [
        {
            "name": "Digital Signature Factory AI",
            "email": "support@dsfactory.ai"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "robrichards/xmlseclibs": "^3.1",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.9",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "DigitalSignatureFactory\\Core\\": "src/core/",
            "DigitalSignatureFactory\\Providers\\": "src/providers/",
            "DigitalSignatureFactory\\Utils\\": "src/utils/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigitalSignatureFactory\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/",
        "phpstan": "phpstan analyse src/ --level max",
        "phpcbf": "phpcbf src/",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
